views:
  - type: table
    name: Health
    filters:
      and:
        - note["watch date"] <= "2026-05-31"
        - note["watch date"] >= "2026-05-01"
        - topic == ["Health"]
    order:
      - file.name
      - topic
      - title
  - type: table
    name: Charisma
    filters:
      and:
        - note["watch date"] <= "2026-05-31"
        - note["watch date"] >= "2026-05-01"
        - topic == ["Charisma"]
    order:
      - file.name
      - topic
      - title
